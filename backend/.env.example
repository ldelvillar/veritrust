ENVIRONMENT=development | production
LOG_FORMAT=text | json

# Required: the app refuses to start without it (validate_runtime)
DATABASE_URL=postgresql://veritrust:change-me@localhost:5432/veritrust

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

FAKE_NEWS_MODEL_PATH=

# Only used by ml/evaluation/evaluate_factcheck.py (Google Fact Check API)
GOOGLE_API_KEY=

CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=

# Email notifications on analysis completion (Resend); unset = feature disabled
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_BASE_URL=https://api.resend.com
# Public frontend origin, used to build the report link in the email
APP_BASE_URL=
# Team inbox that contact/demo form submissions are emailed to; unset = /contact returns 503
CONTACT_TO_EMAIL=
# Per-IP rate limit for POST /contact
CONTACT_RATE_LIMIT_MAX_REQUESTS=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600

# Proveedor de los LLM de los agentes: "ollama" (local) o "mistral" (API alojada)
LLM_PROVIDER=ollama

# Solo con LLM_PROVIDER=mistral; obligatoria en ese caso
MISTRAL_API_KEY=
MISTRAL_EXTRACTOR_MODEL=mistral-small-latest
MISTRAL_TRANSLATOR_MODEL=mistral-small-latest
MISTRAL_HEALTH_EXPERT_MODEL=mistral-small-latest
MISTRAL_JUDGE_MODEL=mistral-small-latest
MISTRAL_MAX_TOKENS=2048
MISTRAL_REQUEST_TIMEOUT_SECONDS=60

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EXTRACTOR_MODEL=llama3
OLLAMA_TRANSLATOR_MODEL=translategemma
OLLAMA_HEALTH_EXPERT_MODEL=llama3.2
OLLAMA_JUDGE_MODEL=llama3.2

OLLAMA_REQUEST_TIMEOUT_SECONDS=240
OLLAMA_EXTRACTOR_NUM_CTX=8192
OLLAMA_EXTRACTOR_NUM_PREDICT=1024
OLLAMA_TRANSLATOR_NUM_CTX=4096
OLLAMA_TRANSLATOR_NUM_PREDICT=2048
OLLAMA_HEALTH_EXPERT_NUM_CTX=8192
OLLAMA_HEALTH_EXPERT_NUM_PREDICT=2048
OLLAMA_JUDGE_NUM_CTX=8192
OLLAMA_JUDGE_NUM_PREDICT=512

EUROPEPMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
EUROPEPMC_TIMEOUT_SECONDS=10

PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
PUBMED_TIMEOUT_SECONDS=10
PUBMED_API_KEY=

OPENFDA_BASE_URL=https://api.fda.gov
OPENFDA_TIMEOUT_SECONDS=10
OPENFDA_API_KEY=

CIMA_BASE_URL=https://cima.aemps.es/cima/rest
CIMA_TIMEOUT_SECONDS=10

REDIS_URL=redis://localhost:6379

ANALYSIS_JOB_TIMEOUT_SECONDS=600
ANALYSIS_STALE_AFTER_SECONDS=300
WORKER_MAX_JOBS=1
