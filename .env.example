# Variables interpolated by docker-compose.yml. Copy to .env at the repo root.
# App settings (LLM provider and keys, Clerk JWKS, Resend, evidence sources) live in backend/.env, which the backend and worker load.

# Postgres (in-compose database). Set a strong POSTGRES_PASSWORD before any non-local deploy
POSTGRES_USER=veritrust
POSTGRES_PASSWORD=change-me
POSTGRES_DB=veritrust

# Redis (in-compose broker). Set a strong REDIS_PASSWORD before any non-local deploy
REDIS_PASSWORD=

# Clerk, for the frontend (from your Clerk dashboard)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Production reverse proxy (only used by docker-compose.prod.yml; leave blank for local)
APP_DOMAIN=
API_DOMAIN=
ACME_EMAIL=
