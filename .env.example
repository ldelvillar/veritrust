# Variables consumed by docker-compose.yml, which also passes every one of them to the backend and worker as Settings. Copy to .env at the repo root.

# Postgres (in-compose database). Set a strong POSTGRES_PASSWORD before any non-local deploy
POSTGRES_USER=veritrust
POSTGRES_PASSWORD=change-me
POSTGRES_DB=veritrust

# Redis (in-compose broker). Set a strong REDIS_PASSWORD before any non-local deploy
REDIS_PASSWORD=

# Worker's LLM provider. Only the chosen one's key is required
LLM_PROVIDER=mistral | groq | google | nvidia | ollama
MISTRAL_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
NVIDIA_API_KEY=

# Evidence sources: a key only raises that API's rate limit; blank = keyless
PUBMED_API_KEY=
OPENFDA_API_KEY=

# Any other field from backend/.env.example (Ollama models, WORKER_MAX_JOBS, timeouts, rate limits) also applies when set here; DATABASE_URL, REDIS_URL and OLLAMA_BASE_URL always come from docker-compose.yml

# Clerk (from your Clerk dashboard)
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Email (Resend).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Team inbox the contact/demo forms are emailed to (backend POST /contact). Blank = /contact returns 503.
CONTACT_TO_EMAIL=
# Report-link base. In prod it's derived from APP_DOMAIN (docker-compose.prod.yml); set only for local email tests.
APP_BASE_URL=

# Production reverse proxy (only used by docker-compose.prod.yml; leave blank for local)
APP_DOMAIN=
API_DOMAIN=
ACME_EMAIL=
